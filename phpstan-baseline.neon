parameters:
	ignoreErrors:
		-
			message: '#^Call to function method_exists\(\) with Illuminate\\Http\\Client\\Factory and ''globalRequestMiddle…'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/ObserveraServiceProvider.php

		-
			message: '#^Call to function method_exists\(\) with Illuminate\\Http\\Client\\Response and ''handlerStats'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/ObserveraServiceProvider.php

		-
			message: '#^Offset ''function'' on array\{file\: string, line\: int, function\: '''', class\: '''', type\: ''''\}\|array\{function\: string, line\?\: int, file\?\: string, class\?\: class\-string, type\?\: ''\-\>''\|''\:\:'', args\?\: list\<mixed\>, object\?\: object\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/ObserveraServiceProvider.php

		-
			message: '#^Property Illuminate\\Log\\Events\\MessageLogged\:\:\$context \(array\) on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.property
			count: 1
			path: src/ObserveraServiceProvider.php

		-
			message: '#^Using nullsafe method call on non\-nullable type Illuminate\\Http\\Request\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 4
			path: src/ObserveraServiceProvider.php
